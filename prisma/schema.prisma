generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BankMessageSource {
  ios_shortcuts
}

enum ParsedStatus {
  pending
  parsed
  failed
  ignored
}

enum PendingExpenseStatus {
  pending
  confirmed
  ignored
  edited
}

enum ExpenseSource {
  manual
  ios_shortcuts
  bank_api
  csv
}

enum CategoryType {
  expense
  income
}

model User {
  id              String           @id @default(uuid())
  telegramId      String           @unique
  username        String?
  firstName       String?
  defaultCurrency String           @default("EUR")
  timezone        String           @default("Europe/Nicosia")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  categories      Category[]
  salaryPlans     SalaryPlan[]
  budgets         MonthlyBudget[]
  undoActions     UndoAction[]
  merchantRules   MerchantRule[]
  pendingExpenses PendingExpense[]
  expenses        Expense[]
}

model IncomingBankMessage {
  id              String           @id @default(uuid())
  source          BankMessageSource
  sender          String?
  text            String
  receivedAt      DateTime?
  rawPayload      Json
  parsedStatus    ParsedStatus     @default(pending)
  parseError      String?
  dedupHash       String           @unique
  createdAt       DateTime         @default(now())
  pendingExpenses PendingExpense[]
  expenses        Expense[]
}

model PendingExpense {
  id                    String               @id @default(uuid())
  userId                String
  incomingBankMessageId String?
  amount                Decimal              @db.Decimal(12, 2)
  currency              String
  merchant              String?
  description           String?
  categoryId            String?
  transactionDate       DateTime?
  status                PendingExpenseStatus @default(pending)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomingBankMessage   IncomingBankMessage? @relation(fields: [incomingBankMessageId], references: [id], onDelete: SetNull)
  category              Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Expense {
  id                    String               @id @default(uuid())
  userId                String
  amount                Decimal              @db.Decimal(12, 2)
  currency              String
  merchant              String?
  description           String?
  categoryId            String?
  transactionDate       DateTime
  source                ExpenseSource
  incomingBankMessageId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomingBankMessage   IncomingBankMessage? @relation(fields: [incomingBankMessageId], references: [id], onDelete: SetNull)
  category              Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, transactionDate])
}

model Category {
  id              String           @id @default(uuid())
  userId          String?
  name            String
  emoji           String?
  type            CategoryType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantRules   MerchantRule[]
  pendingExpenses PendingExpense[]
  expenses        Expense[]

  @@unique([userId, name, type])
}

model MerchantRule {
  id           String   @id @default(uuid())
  userId       String
  pattern      String
  categoryId   String
  merchantName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
}

model MonthlyBudget {
  id        String   @id @default(uuid())
  userId    String
  month     String
  currency  String
  amount    Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month, currency])
}

model UndoAction {
  id        String   @id @default(uuid())
  userId    String
  changes   Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  undoneAt  DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model SalaryPlan {
  id         String   @id @default(uuid())
  userId     String
  currency   String
  salary     Decimal  @db.Decimal(12, 2)
  payday     Int      @default(27)
  background Json
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, currency])
}
